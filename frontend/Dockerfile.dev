FROM node:20-slim
WORKDIR /app
# Install pnpm globally
RUN npm install -g pnpm

# We do not copy source code here because we rely on volume mounts for development
# We do not run install here because it happens at runtime using the volume mount

CMD ["sh", "-c", "pnpm install && pnpm run dev -- --host 0.0.0.0 --port 3000"]
