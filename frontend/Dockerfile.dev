FROM node:20-slim
WORKDIR /app
# Install pnpm globally
RUN npm install -g pnpm

# Pre-install dependencies in the image to avoid runtime install
COPY package.json pnpm-lock.yaml ./
RUN pnpm install

# We do not copy source code here because we rely on volume mounts for development
CMD ["pnpm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
