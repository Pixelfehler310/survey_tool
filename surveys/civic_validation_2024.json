{
  "id": "civic_validation_2024",
  "title": "Civic OS Master Validation Survey",
  "version": "1.0.0",
  "settings": {
    "allow_back": true,
    "show_progress": true,
    "captcha": true,
    "submit_redirect": "/thank-you"
  },
  "branding": {
    "primary_color": "#4f46e5",
    "font_family": "Inter",
    "logo_url": "https://raw.githubusercontent.com/Pixelfehler310/survey_tool/main/logo.png"
  },
  "questions": [
    {
      "id": "screening_student",
      "type": "radio",
      "phase": "screening",
      "text": "Bist du aktuell Student:in?",
      "options": [
        {
          "value": "yes",
          "label": "Ja"
        },
        {
          "value": "no",
          "label": "Nein"
        }
      ],
      "required": true
    },
    {
      "id": "loneliness_freq",
      "type": "scale",
      "phase": "validation",
      "text": "Wie oft hast du letzte Woche alleine gegessen?",
      "config": {
        "min": 0,
        "max": 7,
        "min_label": "Nie",
        "max_label": "Täglich"
      },
      "show_if": "answers.screening_student == 'yes'"
    },
    {
      "id": "pay_intent",
      "type": "radio",
      "phase": "marketing",
      "text": "Würdest du 5€/Monat zahlen, um nie wieder alleine zu essen?",
      "options": [
        {
          "value": "yes",
          "label": "Ja, definitiv"
        },
        {
          "value": "maybe",
          "label": "Vielleicht"
        },
        {
          "value": "no",
          "label": "Nein"
        }
      ],
      "show_if": "answers.loneliness_freq >= 3"
    },
    {
      "id": "age_group",
      "type": "dropdown",
      "phase": "demographics",
      "text": "Welcher Altersgruppe gehörst du an?",
      "options": [
        {
          "value": "18-24",
          "label": "18-24 Jahre"
        },
        {
          "value": "25-34",
          "label": "25-34 Jahre"
        },
        {
          "value": "35-44",
          "label": "35-44 Jahre"
        },
        {
          "value": "45+",
          "label": "45+ Jahre"
        }
      ],
      "required": true
    },
    {
      "id": "feedback",
      "type": "textarea",
      "phase": "feedback",
      "text": "Hast du noch Anmerkungen oder Feedback?",
      "required": false
    }
  ]
}